{
  "name": "citavel-experience",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-assets.mjs",
    "remotion:studio": "remotion studio",
    "render:og": "remotion still OgCard src/app/opengraph-image.jpg --image-format=jpeg --jpeg-quality=90",
    "render:logo": "remotion still LogoLockup public/brand/citavel-logo.png --image-format=png",
    "render:assinatura": "remotion render Assinatura out/brand/citavel-assinatura.mp4 --codec=h264 --x264-preset=slow --pixel-format=yuv420p --crf=20 && remotion render AssinaturaVertical out/brand/citavel-assinatura-9x16.mp4 --codec=h264 --x264-preset=slow --pixel-format=yuv420p --crf=20",
    "render:media": "npm run render:og && npm run render:logo"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.539",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "remotion": "4.0.539",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
